local function createSideButton(index, icon, text)
	local Button = Instance.new("TextButton")
	Button.Size = UDim2.new(1, -18, 0, 42)
	Button.Position = UDim2.new(0, 9, 0, 15 + ((index - 1) * 48))
	Button.BackgroundColor3 = index == 1 and BLUE or Color3.fromRGB(9, 17, 29)
	Button.BorderSizePixel = 0
	Button.Text = icon .. "   " .. text
	Button.TextColor3 = WHITE
	Button.TextSize = 14
	Button.Font = Enum.Font.GothamMedium
	Button.TextXAlignment = Enum.TextXAlignment.Left
	Button.Parent = Side

	local Corner = Instance.new("UICorner")
	Corner.CornerRadius = UDim.new(0, 8)
	Corner.Parent = Button

	Button.MouseButton1Click:Connect(function()
		for _, child in ipairs(Side:GetChildren()) do
			if child:IsA("TextButton") then
				child.BackgroundColor3 = Color3.fromRGB(9, 17, 29)
			end
		end
		Button.BackgroundColor3 = BLUE
	end)
end

