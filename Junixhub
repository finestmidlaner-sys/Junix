local function createFeature(name, index)
	local column = (index - 1) % 2
	local row = math.floor((index - 1) / 2)

	local Button = Instance.new("TextButton")
	Button.Size = UDim2.new(0, 195, 0, 45)
	Button.Position = UDim2.new(0, 10 + column * 205, 0, 48 + row * 55)
	Button.BackgroundColor3 = PANEL2
	Button.BorderSizePixel = 0
	Button.Text = name
	Button.TextColor3 = WHITE
	Button.TextSize = 12
	Button.Font = Enum.Font.GothamMedium
	Button.TextXAlignment = Enum.TextXAlignment.Left
	Button.Parent = FeatureBox

	local Corner = Instance.new("UICorner")
	Corner.CornerRadius = UDim.new(0, 8)
	Corner.Parent = Button

	local Toggle = Instance.new("Frame")
	Toggle.Size = UDim2.new(0, 34, 0, 18)
	Toggle.Position = UDim2.new(1, -45, 0.5, -9)
	Toggle.BackgroundColor3 = Color3.fromRGB(40, 55, 75)
	Toggle.Parent = Button

	local ToggleCorner = Instance.new("UICorner")
	ToggleCorner.CornerRadius = UDim.new(1, 0)
	ToggleCorner.Parent = Toggle

	local Dot = Instance.new("Frame")
	Dot.Size = UDim2.new(0, 14, 0, 14)
	Dot.Position = UDim2.new(0, 2, 0.5, -7)
	Dot.BackgroundColor3 = Color3.fromRGB(150, 180, 215)
	Dot.Parent = Toggle

	local DotCorner = Instance.new("UICorner")
	DotCorner.CornerRadius = UDim.new(1, 0)
	DotCorner.Parent = Dot

	local enabled = false

	Button.MouseButton1Click:Connect(function()
		enabled = not enabled

		if enabled then
			Toggle.BackgroundColor3 = BLUE
			Dot.BackgroundColor3 = WHITE
			Dot.Position = UDim2.new(1, -16, 0.5, -7)
		else
			Toggle.BackgroundColor3 = Color3.fromRGB(40, 55, 75)
			Dot.BackgroundColor3 = Color3.fromRGB(150, 180, 215)
			Dot.Position = UDim2.new(0, 2, 0.5, -7)
		end
	end)
end

